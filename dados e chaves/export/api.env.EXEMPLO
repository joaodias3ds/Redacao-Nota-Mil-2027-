# === API / servidor — SECRETS (nunca no app) ===

# Supabase
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...SUBSTITUA
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE_NUNCA_NO_CLIENTE
SUPABASE_JWT_SECRET=SUBSTITUA

# Neon (Postgres do app — sa-east-1 recomendado)
DATABASE_URL=postgresql://USER:SENHA@HOST/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:SENHA@HOST-pooler/neondb?sslmode=require

# Gemini (pré-correção)
GEMINI_API_KEY=AIza...SUBSTITUA
GEMINI_MODEL=gemini-2.5-flash

# Google — Gmail do curso (OAuth)
GOOGLE_GMAIL_CURSO_CLIENT_ID=
GOOGLE_GMAIL_CURSO_CLIENT_SECRET=
GOOGLE_GMAIL_CURSO_REFRESH_TOKEN=
GOOGLE_GMAIL_CURSO_SENDER=curso@seudominio.com

# Google — 2º Gmail (admin/suporte)
GOOGLE_GMAIL_ADMIN_CLIENT_ID=
GOOGLE_GMAIL_ADMIN_CLIENT_SECRET=
GOOGLE_GMAIL_ADMIN_REFRESH_TOKEN=
GOOGLE_GMAIL_ADMIN_SENDER=voce@gmail.com

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
